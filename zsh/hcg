#!/usr/bin/env bash

UTLZ="$HOME/zutlz"
usage() {
  echo "----------------------------"
  echo "Usage       : $(basename "$0")"
  echo "Description : hcg info"
  echo "----------------------------"
  exit 1
}

if [ "$1" == "-h" ] || [ ! -z "$1" ]; then
  usage
fi

open -n "$UTLZ/ij/IntelliJ IDEA.app" --args nosplash $HOME/zdocs/hcg/info
exit 0