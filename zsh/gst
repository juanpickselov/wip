#!/usr/bin/env bash

usage() {
  echo "----------------------------------"
  echo "Usage       : $(basename "$0") [args]"
  echo "Description : git status for all remotes"
  echo "----------------------------------"
}

if [[ "$1" == "-h" ]]; then
  usage
  exit 1
fi

current_branch=$(git branch --show-current)

if [[ -z "$current_branch" ]]; then
  echo "Error: Not currently on any branch (detached HEAD)."
  exit 1
fi

echo "Fetching latest changes from all remotes..."
git fetch --all --quiet

for remote in $(git remote); do
  echo "----------------------------------------"
  echo "Remote: $remote ($current_branch)"
  echo "----------------------------------------"
  
  if ! git rev-parse --verify --quiet "$remote/$current_branch" > /dev/null; then
    echo "Status: Branch does not exist on this remote."
    continue
  fi

  ahead=$(git rev-list --count "$remote/$current_branch..HEAD")
  behind=$(git rev-list --count "HEAD..$remote/$current_branch")

  if [[ $ahead -eq 0 && $behind -eq 0 ]]; then
    echo "Status: Up to date."
  elif [[ $ahead -gt 0 && $behind -eq 0 ]]; then
    echo "Status: Ahead by $ahead commit(s). (Need to push)"
  elif [[ $ahead -eq 0 && $behind -gt 0 ]]; then
    echo "Status: Behind by $behind commit(s). (Need to pull)"
  else
    echo "Status: Diverged! Ahead by $ahead and behind by $behind commit(s)."
  fi
done

echo "----------------------------------------"
echo "Local File Status:"
git status -s "$@"
exit 0
